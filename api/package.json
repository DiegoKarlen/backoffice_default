{
  "name": "admin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --schema=../database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=../database/prisma/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "test": "tsx scripts/run-tests.mts",
    "test:unit": "tsx scripts/run-tests.mts unit",
    "test:integration": "tsx scripts/run-tests.mts integration",
    "test:prizes": "tsx scripts/run-tests.mts prizes",
    "test:wallet": "tsx scripts/run-tests.mts wallet",
    "test:engine": "tsx scripts/run-tests.mts engine",
    "test:lib": "tsx scripts/run-tests.mts lib",
    "test:list": "tsx scripts/run-tests.mts --list"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
