{
  "private": true,
  "scripts": {
    "test": "powershell -ExecutionPolicy Bypass -File scripts/test-all.ps1",
    "test:api": "npm test --prefix api",
    "test:api:unit": "npm run test:unit --prefix api",
    "test:api:integration": "npm run test:integration --prefix api",
    "test:api:prizes": "npm run test:prizes --prefix api",
    "test:api:wallet": "npm run test:wallet --prefix api",
    "test:shared": "npx tsx --test packages/shared/tests/unit/*.unit.test.ts",
    "lint": "eslint api/src player-portal/src bingo-display/src packages/shared/src"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.33.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
