// Single-tenant backoffice: users, roles, functionalities (RBAC).

generator client {
  provider = "prisma-client-js"
  /// Resolve `@prisma/client` from the API package (avoids stale client in `api/node_modules`).
  output   = "../../api/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  displayName  String?
  active       Boolean    @default(true)
  /// Base32 secret for TOTP (Google Authenticator / Microsoft Authenticator). Null = not configured.
  totpSecret   String?
  /// When true, login requires a valid TOTP after password (`totpSecret` must be set).
  totpEnabled  Boolean    @default(false)
  /// Incremented to invalidate outstanding backoffice JWTs (password change, deactivation, etc.).
  tokenVersion Int        @default(0)
  roles        UserRole[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  bingosCreated Bingo[] @relation("BingoCreatedBy")
  bingosUpdated Bingo[] @relation("BingoUpdatedBy")
  adminAuditLogs AdminAuditLog[]
}

model Role {
  id              String              @id @default(uuid())
  code            String              @unique
  name            String
  description     String?
  users           UserRole[]
  functionalities RoleFunctionality[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Functionality {
  id          String              @id @default(uuid())
  code        String              @unique
  name        String
  description String?
  /// Grouping for menus or feature flags per product area.
  module      String?
  roles       RoleFunctionality[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RoleFunctionality {
  roleId          String
  functionalityId String
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  functionality   Functionality @relation(fields: [functionalityId], references: [id], onDelete: Cascade)

  @@id([roleId, functionalityId])
}

enum BingoType {
  BINGO_75
  BINGO_90
}

enum BingoStatus {
  ACTIVE
  INACTIVE
}

/** Cómo se reparte el monto configurado por premio entre ganadores de la misma figura. */
enum PrizePayoutMode {
  /// Cada ganador cobra el monto completo del premio.
  IMMEDIATE_FULL_PER_WINNER
  /// El monto del premio se divide en partes iguales entre los ganadores de esa figura en la misma bolilla.
  DEFERRED_SPLIT_AT_ROUND_END
}

/** Cuándo se acredita la billetera del jugador tras ganar una figura. */
enum PrizeSettlementTiming {
  /// Al detectar la figura (misma bolilla ganadora).
  ON_FIGURE
  /// Al cerrar la partida (comportamiento por defecto).
  AT_ROUND_END
}

/// Virtual = bolas por motor/RNG; Live = operador marca bolas en display (video).
enum BingoDrawMode {
  VIRTUAL
  LIVE
}

// --- Bingo (simplified) ---

enum BingoFigure {
  LINE
  DOUBLE_LINE
  LETTER_B
  LETTER_I
  LETTER_N
  LETTER_G
  LETTER_O
  PERIMETER
  JACKPOT
  FULL_HOUSE
}

/// Modo de premios del bingo: todos los premios son montos fijos o todos son % del pozo.
enum BingoPrizeMode {
  FIXED
  PERCENTAGE
}

enum RoomStatus {
  ACTIVE
  INACTIVE
}

/// Physical/virtual room: groups one or more bingos.
model Room {
  id        String     @id @default(uuid())
  name      String
  /// URL segment for the public bingo display: /r/{slug}
  slug      String     @unique
  status    RoomStatus @default(INACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  bingos    Bingo[]

  @@index([status])
}

model Bingo {
  id                 String       @id @default(uuid())
  roomId             String
  room               Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  name               String
  status             BingoStatus  @default(INACTIVE)
  bingoType          BingoType
  startDateTime      DateTime
  /// Último instante permitido para programar una partida (inicio). Null = sin límite.
  endDateTime        DateTime?
  repeatEveryMinutes Int?
  cardPrice          Decimal      @db.Decimal(14, 4)
  /// Todos los premios del bingo: monto fijo o porcentaje del pozo de la partida.
  prizeMode          BingoPrizeMode @default(FIXED)
  /// Pozo inicial por partida cuando `prizeMode` = PERCENTAGE (+ ventas de cartones).
  prizePoolSeed      Decimal      @default(0) @db.Decimal(14, 4)
  minPlayersToStart  Int          @default(2)
  prizePayoutMode       PrizePayoutMode       @default(IMMEDIATE_FULL_PER_WINNER)
  prizeSettlementTiming PrizeSettlementTiming @default(AT_ROUND_END)
  drawMode              BingoDrawMode         @default(VIRTUAL)
  /// Si true, cartón lleno antes de `jackpotMaxBall` gana el premio JACKPOT (monto fijo).
  jackpotEnabled     Boolean       @default(false)
  jackpotMaxBall     Int?
  jackpotAmount      Decimal?      @db.Decimal(14, 4)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  createdByUserId    String?
  updatedByUserId    String?
  createdBy          User?        @relation("BingoCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy          User?        @relation("BingoUpdatedBy", fields: [updatedByUserId], references: [id])
  prizes             BingoPrize[]
  rounds             BingoRound[]

  @@index([status])
  @@index([startDateTime])
  @@index([bingoType])
  @@index([roomId])
}

enum BingoRoundStatus {
  SCHEDULED
  DRAWING
  COMPLETED
  CANCELLED
}

/// Partida concreta (ocurrencia programada); materializada al guardar el bingo para poder asociar cartones antes del sorteo.
model BingoRound {
  id               String            @id @default(uuid())
  bingoId          String
  bingo            Bingo             @relation(fields: [bingoId], references: [id], onDelete: Cascade)
  /// Número de partida dentro del bingo (UI “PARTIDA #N”).
  sequence         Int
  startsAt         DateTime
  status           BingoRoundStatus  @default(SCHEDULED)
  /// Código estable cuando `status` = CANCELLED (ver `bingo-round-cancellation.ts`).
  cancellationReason String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  balls            BingoRoundBall[]
  cartonPurchases  CartonPurchase[]
  playerRoundCards PlayerRoundCard[]
  deferredPrizeWins DeferredRoundPrizeWin[]

  @@unique([bingoId, startsAt])
  @@index([bingoId, status])
  @@index([bingoId, sequence])
}

model BingoRoundBall {
  id        String     @id @default(uuid())
  roundId   String
  round     BingoRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  drawOrder Int
  number    Int

  @@unique([roundId, drawOrder])
  @@unique([roundId, number])
  @@index([roundId])
}

model BingoPrize {
  id              String               @id @default(uuid())
  bingoId         String
  bingo           Bingo                @relation(fields: [bingoId], references: [id], onDelete: Cascade)
  figure          BingoFigure
  /// Monto fijo (ARS) o % del pozo (0–100), según `Bingo.prizeMode`.
  amount          Decimal              @db.Decimal(14, 4)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payouts         PrizePayout[]
  deferredWins    DeferredRoundPrizeWin[]

  @@unique([bingoId, figure])
  @@index([bingoId])
}

// --- Players (public app): separate from backoffice User ---

enum WalletTransactionType {
  DEPOSIT
  CARTON_PURCHASE
  PRIZE_CREDIT
  ADJUSTMENT
  REFUND
}

enum DepositStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Public-facing player account (register / wallet / purchases). Not linked to User (RBAC).
model Player {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  active           Boolean   @default(true)
  /// Incremented to invalidate outstanding player JWTs (password change, deactivation, etc.).
  tokenVersion     Int       @default(0)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  /// ID numérico estable para gateways de pago (MixerGaming `user_id`).
  paymentsUserId  Int       @unique @default(autoincrement())
  firstName       String?
  lastName        String?
  phone           String?
  phoneCode       String?   @default("54")
  dni             String?
  countryCode     String?   @default("AR")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  wallet           Wallet?
  deposits         Deposit[]
  cartonPurchases  CartonPurchase[]
  playerRoundCards PlayerRoundCard[]
  prizePayouts     PrizePayout[]
  deferredRoundPrizeWins DeferredRoundPrizeWin[]
}

/// One wallet per player; balances in integer cents (single currency code for now).
model Wallet {
  id           String   @id @default(uuid())
  playerId     String   @unique
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  balanceCents Int      @default(0)
  currencyCode String   @default("ARS")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions WalletTransaction[]
}

/// Ledger line: amountCents negative = debit, positive = credit. Exactly one source FK should be set (by type).
model WalletTransaction {
  id                String                @id @default(uuid())
  walletId          String
  wallet            Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type              WalletTransactionType
  amountCents       Int
  balanceAfterCents Int?
  createdAt         DateTime              @default(now())

  depositId String?  @unique
  deposit   Deposit? @relation(fields: [depositId], references: [id], onDelete: Restrict)

  cartonPurchaseId String?         @unique
  cartonPurchase   CartonPurchase? @relation(fields: [cartonPurchaseId], references: [id], onDelete: Restrict)

  /// Crédito por cancelación de partida (reembolso de la compra asociada).
  refundForCartonPurchaseId String? @unique
  refundForCartonPurchase   CartonPurchase? @relation("CartonPurchaseRefund", fields: [refundForCartonPurchaseId], references: [id], onDelete: Restrict)

  prizePayoutId String?      @unique
  prizePayout   PrizePayout? @relation(fields: [prizePayoutId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([type])
}

/// Configurable deposit gateway method (enabled/disabled from backoffice).
model PaymentMethod {
  id           String   @id @default(uuid())
  providerId   String
  /// Gateway-side method id (e.g. Mixer payment_method "84").
  externalId   String
  name         String
  currencyCode String   @default("ARS")
  minCents     Int
  maxCents     Int
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deposits Deposit[]

  @@unique([providerId, externalId])
  @@index([active, sortOrder])
}

model Deposit {
  id                String         @id @default(uuid())
  playerId          String
  player            Player         @relation(fields: [playerId], references: [id], onDelete: Restrict)
  amountCents       Int
  currencyCode      String         @default("ARS")
  status            DepositStatus  @default(PENDING)
  providerId        String?
  paymentMethodId   String?
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  paymentMethodName String?
  /// Gateway transaction id (set at initiate; used to match webhooks).
  externalRef            String?
  /// Gateway response when the deposit was initiated (create transaction).
  providerPayload        Json?
  /// Raw JSON body received from the gateway webhook.
  webhookPayload         Json?
  /// JSON body we returned to the gateway for this webhook call.
  webhookResponse        Json?
  webhookReceivedAt      DateTime?
  failedReason           String?
  createdAt              DateTime      @default(now())
  completedAt            DateTime?

  walletTransaction WalletTransaction?

  @@unique([providerId, externalRef])
  @@index([playerId, createdAt])
}

/// Purchase of one or more cartons for a round; pricing snapshot at purchase time.
model CartonPurchase {
  id             String     @id @default(uuid())
  playerId       String
  player         Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  bingoRoundId   String
  bingoRound     BingoRound @relation(fields: [bingoRoundId], references: [id], onDelete: Restrict)
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  createdAt      DateTime   @default(now())

  playerRoundCards  PlayerRoundCard[]
  walletTransaction     WalletTransaction?
  refundWalletTransaction WalletTransaction? @relation("CartonPurchaseRefund")

  @@index([playerId, createdAt])
  @@index([bingoRoundId])
}

/// One emitted carton for a round; cardFingerprint prevents duplicate grids within the same round.
model PlayerRoundCard {
  id               String         @id @default(uuid())
  playerId         String
  player           Player         @relation(fields: [playerId], references: [id], onDelete: Restrict)
  bingoRoundId     String
  bingoRound       BingoRound     @relation(fields: [bingoRoundId], references: [id], onDelete: Restrict)
  cartonPurchaseId String
  cartonPurchase   CartonPurchase @relation(fields: [cartonPurchaseId], references: [id], onDelete: Restrict)
  cardIndex        Int
  /// Stable hash of grid contents for uniqueness within bingoRoundId (e.g. SHA-256 hex).
  cardFingerprint  String         @db.VarChar(64)
  createdAt        DateTime       @default(now())

  cells        BingoCardCell[]
  prizePayouts PrizePayout[]
  deferredRoundPrizeWins DeferredRoundPrizeWin[]

  @@unique([bingoRoundId, cardFingerprint])
  @@index([playerId])
  @@index([cartonPurchaseId])
}

/// Normalized grid cell for a player card (BINGO_75 / BINGO_90 layout rules enforced in app).
model BingoCardCell {
  id                String          @id @default(uuid())
  playerRoundCardId String
  playerRoundCard   PlayerRoundCard @relation(fields: [playerRoundCardId], references: [id], onDelete: Cascade)
  row               Int
  col               Int
  number            Int?
  isFree            Boolean         @default(false)

  @@unique([playerRoundCardId, row, col])
  @@index([playerRoundCardId])
}

/// Ganador elegible durante la partida si `Bingo.prizePayoutMode` = DEFERRED_SPLIT_AT_ROUND_END — la wallet se acredita al cerrar la ronda.
model DeferredRoundPrizeWin {
  id                String         @id @default(uuid())
  bingoRoundId      String
  bingoRound        BingoRound     @relation(fields: [bingoRoundId], references: [id], onDelete: Cascade)
  bingoPrizeId      String
  bingoPrize        BingoPrize     @relation(fields: [bingoPrizeId], references: [id], onDelete: Cascade)
  playerId          String
  player            Player         @relation(fields: [playerId], references: [id], onDelete: Restrict)
  playerRoundCardId String
  playerRoundCard   PlayerRoundCard @relation(fields: [playerRoundCardId], references: [id], onDelete: Restrict)
  createdAt         DateTime       @default(now())

  @@unique([bingoRoundId, bingoPrizeId, playerRoundCardId])
  @@index([bingoRoundId])
}

/// Prize credited to the player; winning card + configured prize row.
model PrizePayout {
  id                String          @id @default(uuid())
  playerId          String
  player            Player          @relation(fields: [playerId], references: [id], onDelete: Restrict)
  bingoPrizeId      String
  bingoPrize        BingoPrize      @relation(fields: [bingoPrizeId], references: [id], onDelete: Restrict)
  playerRoundCardId String
  playerRoundCard   PlayerRoundCard @relation(fields: [playerRoundCardId], references: [id], onDelete: Restrict)
  amountCents       Int
  createdAt         DateTime        @default(now())

  walletTransaction WalletTransaction?

  @@unique([bingoPrizeId, playerRoundCardId])
  @@index([playerId, createdAt])
  @@index([bingoPrizeId])
  @@index([playerRoundCardId])
}

enum AdminAuditAction {
  MANUAL_WALLET_CREDIT
  BALL_DRAWN
  ROUND_STOPPED
}

/// Backoffice admin actions audit trail (manual credits, etc.).
model AdminAuditLog {
  id          String           @id @default(uuid())
  adminUserId String
  adminUser   User             @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  action      AdminAuditAction
  /// Target entity type, e.g. `player`.
  targetType  String
  targetId    String
  amountCents Int?
  note        String?
  depositId   String?
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}
